{
  "expo": {
    "name": "Vocab-U",
    "slug": "vocab-u",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vocabu",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "org.vocabu.app" },
    "android": {
      "package": "org.vocabu.app",
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": { "typedRoutes": true }
  }
}
