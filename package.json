{
  "name": "vocab-u",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --no-bail typecheck",
    "corpus:build": "pnpm --filter @vocab-u/corpus build",
    "mobile": "pnpm --filter @vocab-u/mobile start",
    "prepare:assets": "node -e \"require('node:fs').copyFileSync('tools/corpus/out/vocab.db','apps/mobile/assets/corpus/vocab.db')\""
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
